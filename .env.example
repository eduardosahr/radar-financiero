# Copia este archivo como .env y llena tus llaves. El archivo .env nunca se sube a GitHub.

# Token gratuito: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Llave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Pago por uso: https://console.anthropic.com (configura un límite de gasto mensual)
ANTHROPIC_API_KEY=

# Opcional, para recibir el informe diario (instrucciones en radar/reports/telegram.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
